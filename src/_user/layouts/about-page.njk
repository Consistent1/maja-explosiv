---
layout: sidebar-layout.njk
---
{# Layout for the Bio/Timeline/Press/Links page cluster - renders whichever
   structured content shape the page provides. Bio is plain markdown;
   Timeline/Press/Links are structured data (see their front matter) since
   that's what the real content actually is.

   No quick-switcher nav here on purpose: the sidebar already links each of
   these (as homepage tab anchors), and the site's model is sidebar-fixed /
   content-switches-in-place via tabs, not page-to-page navigation between
   sibling pages - these standalone routes exist as direct-linkable/permalink
   targets, same pattern as individual project pages (which also have no
   redundant category-switcher of their own). #}

<article class="page-content about-subpage">
    {% if timelineSections %}
        <div class="page-body about-timeline">
            {% for section in timelineSections %}
                <h2 class="about-timeline-heading">{{ section.heading }}</h2>
                <dl class="about-timeline-list">
                    {% for entry in section.entries %}
                        <div class="about-timeline-entry">
                            <dt class="about-timeline-date">{{ entry.date }}</dt>
                            <dd class="about-timeline-text">{{ entry.text }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            {% endfor %}
        </div>
    {% elif linkCategories %}
        <div class="page-body about-links">
            {% for category in linkCategories %}
                <h2 class="about-links-heading">{{ category.heading }}</h2>
                <ul class="about-links-list">
                    {% for entry in category.entries %}
                        <li class="about-links-entry">
                            {% if entry.text %}{{ entry.text }} {% endif %}
                            <a href="{{ entry.url }}" target="_blank" rel="noopener">{{ entry.name }}</a>{{ entry.suffix }}
                        </li>
                    {% endfor %}
                </ul>
            {% endfor %}
        </div>
    {% elif pressEntries %}
        <div class="page-body about-press">
            {% if pressNote %}<p class="about-press-note">{{ pressNote }}</p>{% endif %}
            <ul class="about-press-list">
                {% for entry in pressEntries %}
                    <li class="about-press-entry">{{ entry }}</li>
                {% endfor %}
            </ul>
        </div>
    {% else %}
        <div class="page-body">
            {{ content | safe }}
        </div>
    {% endif %}
</article>
