# Archive of the original site's image/media files, rebuilt from old/TYPO3BU/ by
# migrated-content/_tools/build_archive.py. ~400 MB of untouched originals; a
# deliverable for Maja and the master for producing site images, not site content.
# Its manifest.tsv IS worth committing -- see image-archive/README.md.
/image-archive

# Build output for GitHub Pages. No longer tracked: Pages builds via
# .github/workflows/deploy-pages.yml since 2026-08-26. Tracking it committed a
# second copy of the whole site and rewrote every file on each deploy.
# The docs/ route is RETIRED, NOT REMOVED -- build:github / copy:docs /
# deploy:github stay in package.json as a fallback. To go back: comment the
# next line out, `npm run deploy:github`, commit docs/, THEN set
# Settings -> Pages -> Source to "Deploy from a branch: main /docs".
# See README -> "3. Going back to the `docs/` route".
/docs

# Staging area for files pulled from the live server (the non-ASCII filenames the
# January 2025 backup dropped). Verified, then folded into old/TYPO3BU/.
/incoming

# Python bytecode from migrated-content/_tools/
__pycache__/
